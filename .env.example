# Copiar a .env y completar los valores reales.
# NUNCA commitear el .env con valores reales.

# API key de Anthropic — obtener en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Puerto del servidor Express (default: 3001)
PORT=3001

# Origen permitido para CORS en producción (default: localhost:5173 en dev)
# En producción, cambiar por el dominio real. Ej: https://mitico.bar
ALLOWED_ORIGIN=http://localhost:5173
