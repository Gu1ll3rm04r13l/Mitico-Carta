# Copiar a .env y completar los valores reales.
# NUNCA commitear el .env con valores reales.

# ─── Groq (chat IA) ─────────────────────────────────────────────────────────
# Obtener en https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ─── Servidor Express (dev local) ───────────────────────────────────────────
PORT=3001
# Origen permitido CORS. En prod: https://mitico.bar
ALLOWED_ORIGIN=http://localhost:5173

# ─── Supabase ───────────────────────────────────────────────────────────────
# dashboard.supabase.com → Settings → API
# Las mismas VITE_* las consume frontend + server (server tiene fallback).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ─── Admin ──────────────────────────────────────────────────────────────────
# Token oculto en query string para acceder al panel: /?access=TOKEN
# Generar string aleatorio largo (32+ chars). Ej: openssl rand -hex 24
VITE_ADMIN_TOKEN=MITICO...
